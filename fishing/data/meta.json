{"duration": 90.39, "lines": [{"who": "narr", "start": 0.5, "end": 6.005, "text": "Дед Михалыч и внук Витя поехали на рыбалку. Клёва не было уже шесть часов.", "words": [["Дед", 0.525, 0.725, false], ["Михалыч", 0.725, 1.326, false], ["и", 1.326, 1.526, false], ["внук", 1.526, 1.727, false], ["Витя", 1.727, 2.127, false], ["поехали", 2.127, 2.928, false], ["на", 2.928, 3.128, false], ["рыбалку.", 3.128, 3.849, false], ["Клёва", 3.849, 4.25, false], ["не", 4.25, 4.45, false], ["было", 4.45, 4.851, false], ["уже", 4.851, 5.251, false], ["шесть", 5.251, 5.451, false], ["часов.", 5.451, 5.972, false]]}, {"who": "mikh", "start": 6.305, "end": 9.044, "text": "Тихо! Рыбу распугаешь! Ну где ты, блядь, рыба?!", "words": [["Тихо!", 6.305, 6.719, false], ["Рыбу", 6.719, 7.037, false], ["распугаешь!", 7.037, 7.77, false], ["Ну", 7.77, 7.929, false], ["где", 7.929, 8.088, false], ["ты,", 8.088, 8.343, false], ["блядь,", 8.343, 8.598, true], ["рыба?!", 8.598, 9.012, false]]}, {"who": "vit", "start": 9.294, "end": 10.724, "text": "Дед, а может, она на диете?", "words": [["Дед,", 9.294, 9.477, false], ["а", 9.477, 9.592, false], ["может,", 9.592, 9.89, false], ["она", 9.89, 10.12, false], ["на", 10.12, 10.234, false], ["диете?", 10.234, 10.647, false]]}, {"who": "narr", "start": 11.024, "end": 12.905, "text": "И тут у Вити клюнуло.", "words": [["И", 11.049, 11.262, false], ["тут", 11.262, 11.475, false], ["у", 11.475, 11.688, false], ["Вити", 11.688, 12.113, false], ["клюнуло.", 12.113, 12.879, false]]}, {"who": "vit", "start": 13.055, "end": 14.701, "text": "Дед! Клюёт! Тащу!", "words": [["Дед!", 13.08, 13.455, false], ["Клюёт!", 13.455, 14.064, false], ["Тащу!", 14.064, 14.672, false]]}, {"who": "narr", "start": 15.001, "end": 19.494, "text": "Он вытащил ботинок. Левый. Потом старую шину. Потом унитаз.", "words": [["Он", 15.027, 15.216, false], ["вытащил", 15.216, 15.785, false], ["ботинок.", 15.785, 16.468, false], ["Левый.", 16.468, 16.961, false], ["Потом", 16.961, 17.34, false], ["старую", 17.34, 17.909, false], ["шину.", 17.909, 18.402, false], ["Потом", 18.402, 18.781, false], ["унитаз.", 18.781, 19.464, false]]}, {"who": "mikh", "start": 19.744, "end": 21.168, "text": "Ты чё, мусоровоз ловишь, дебил?!", "words": [["Ты", 19.745, 19.863, false], ["чё,", 19.863, 20.052, false], ["мусоровоз", 20.052, 20.524, false], ["ловишь,", 20.524, 20.83, false], ["дебил?!", 20.83, 21.137, true]]}, {"who": "narr", "start": 21.518, "end": 25.428, "text": "И вдруг удочку дёрнуло так, что лодка сорвалась с места.", "words": [["И", 21.543, 21.744, false], ["вдруг", 21.744, 21.945, false], ["удочку", 21.945, 22.548, false], ["дёрнуло", 22.548, 23.151, false], ["так,", 23.151, 23.472, false], ["что", 23.472, 23.673, false], ["лодка", 23.673, 24.075, false], ["сорвалась", 24.075, 24.678, false], ["с", 24.678, 24.879, false], ["места.", 24.879, 25.401, false]]}, {"who": "vit", "start": 25.728, "end": 28.88, "text": "Дед, это кит! Или сом! Или это пиздец!", "words": [["Дед,", 25.757, 26.078, false], ["это", 26.078, 26.48, false], ["кит!", 26.48, 26.802, false], ["Или", 26.802, 27.204, false], ["сом!", 27.204, 27.525, false], ["Или", 27.525, 27.928, false], ["это", 27.928, 28.33, false], ["пиздец!", 28.33, 28.852, true]]}, {"who": "mikh", "start": 29.08, "end": 31.525, "text": "Не отпускай, внучок! Это ужин на всю неделю!", "words": [["Не", 29.083, 29.226, false], ["отпускай,", 29.226, 29.742, false], ["внучок!", 29.742, 30.114, false], ["Это", 30.114, 30.4, false], ["ужин", 30.4, 30.687, false], ["на", 30.687, 30.83, false], ["всю", 30.83, 30.973, false], ["неделю!", 30.973, 31.488, false]]}, {"who": "narr", "start": 31.825, "end": 36.766, "text": "Сом тащил лодку по озеру быстрее катера. Дед орал, а Витя снимал сторис.", "words": [["Сом", 31.84, 32.023, false], ["тащил", 32.023, 32.388, false], ["лодку", 32.388, 32.753, false], ["по", 32.753, 32.936, false], ["озеру", 32.936, 33.484, false], ["быстрее", 33.484, 34.032, false], ["катера.", 34.032, 34.69, false], ["Дед", 34.69, 34.872, false], ["орал,", 34.872, 35.347, false], ["а", 35.347, 35.53, false], ["Витя", 35.53, 35.895, false], ["снимал", 35.895, 36.261, false], ["сторис.", 36.261, 36.736, false]]}, {"who": "vit", "start": 37.016, "end": 39.314, "text": "Дед, у меня сторис набрал тысячу лайков!", "words": [["Дед,", 37.075, 37.324, false], ["у", 37.324, 37.48, false], ["меня", 37.48, 37.791, false], ["сторис", 37.791, 38.103, false], ["набрал", 38.103, 38.415, false], ["тысячу", 38.415, 38.882, false], ["лайков!", 38.882, 39.287, false]]}, {"who": "mikh", "start": 39.514, "end": 41.826, "text": "Какие лайки?! У меня челюсть улетела, сука!", "words": [["Какие", 39.515, 39.9, false], ["лайки?!", 39.9, 40.234, false], ["У", 40.234, 40.363, false], ["меня", 40.363, 40.619, false], ["челюсть", 40.619, 40.876, false], ["улетела,", 40.876, 41.466, false], ["сука!", 41.466, 41.8, true]]}, {"who": "narr", "start": 42.126, "end": 46.514, "text": "Лодка пронеслась мимо пляжа. Отдыхающие синхронно уронили пиво.", "words": [["Лодка", 42.15, 42.495, false], ["пронеслась", 42.495, 43.011, false], ["мимо", 43.011, 43.356, false], ["пляжа.", 43.356, 43.803, false], ["Отдыхающие", 43.803, 44.836, false], ["синхронно", 44.836, 45.353, false], ["уронили", 45.353, 46.042, false], ["пиво.", 46.042, 46.489, false]]}, {"who": "vit", "start": 46.714, "end": 47.476, "text": "Дед, рули!", "words": [["Дед,", 46.74, 47.008, false], ["рули!", 47.008, 47.443, false]]}, {"who": "mikh", "start": 47.676, "end": 49.383, "text": "Чем рулить?! Это же удочка, блядь!", "words": [["Чем", 47.676, 47.818, false], ["рулить?!", 47.818, 48.188, false], ["Это", 48.188, 48.472, false], ["же", 48.472, 48.615, false], ["удочка,", 48.615, 49.126, false], ["блядь!", 49.126, 49.354, true]]}, {"who": "narr", "start": 49.683, "end": 53.947, "text": "Сом то нырял, то выпрыгивал. И, кажется, ржал.", "words": [["Сом", 49.698, 49.947, false], ["то", 49.947, 50.195, false], ["нырял,", 50.195, 50.841, false], ["то", 50.841, 51.089, false], ["выпрыгивал.", 51.089, 52.232, false], ["И,", 52.232, 52.629, false], ["кажется,", 52.629, 53.523, false], ["ржал.", 53.523, 53.921, false]]}, {"who": "narr", "start": 65.4, "end": 70.688, "text": "Через час сом выдохся. Дед тоже. Они долго смотрели друг на друга.", "words": [["Через", 65.406, 65.866, false], ["час", 65.866, 66.097, false], ["сом", 66.097, 66.327, false], ["выдохся.", 66.327, 67.156, false], ["Дед", 67.156, 67.386, false], ["тоже.", 67.386, 67.985, false], ["Они", 67.985, 68.446, false], ["долго", 68.446, 68.906, false], ["смотрели", 68.906, 69.597, false], ["друг", 69.597, 69.827, false], ["на", 69.827, 70.058, false], ["друга.", 70.058, 70.656, false]]}, {"who": "mikh", "start": 70.988, "end": 74.003, "text": "Слышь, сом. Давай по-мужски: ты нас не ешь, мы тебя не варим.", "words": [["Слышь,", 70.994, 71.232, false], ["сом.", 71.232, 71.471, false], ["Давай", 71.471, 71.768, false], ["по-мужски:", 71.768, 72.304, false], ["ты", 72.304, 72.453, false], ["нас", 72.453, 72.602, false], ["не", 72.602, 72.751, false], ["ешь,", 72.751, 72.989, false], ["мы", 72.989, 73.138, false], ["тебя", 73.138, 73.436, false], ["не", 73.436, 73.585, false], ["варим.", 73.585, 73.972, false]]}, {"who": "narr", "start": 74.353, "end": 79.372, "text": "Сом кивнул, махнул хвостом и уплыл. А на крючке остался старый кошелёк.", "words": [["Сом", 74.367, 74.576, false], ["кивнул,", 74.576, 75.12, false], ["махнул", 75.12, 75.538, false], ["хвостом", 75.538, 75.957, false], ["и", 75.957, 76.166, false], ["уплыл.", 76.166, 76.71, false], ["А", 76.71, 76.919, false], ["на", 76.919, 77.128, false], ["крючке", 77.128, 77.547, false], ["остался", 77.547, 78.175, false], ["старый", 78.175, 78.593, false], ["кошелёк.", 78.593, 79.346, false]]}, {"who": "vit", "start": 79.622, "end": 80.976, "text": "Дед, там пятьсот рублей!", "words": [["Дед,", 79.648, 79.933, false], ["там", 79.933, 80.112, false], ["пятьсот", 80.112, 80.468, false], ["рублей!", 80.468, 80.932, false]]}, {"who": "mikh", "start": 81.226, "end": 83.528, "text": "Нахуй мне пятьсот! Я сома упустил, сука!", "words": [["Нахуй", 81.252, 81.554, true], ["мне", 81.554, 81.705, false], ["пятьсот!", 81.705, 82.099, false], ["Я", 82.099, 82.25, false], ["сома", 82.25, 82.553, false], ["упустил,", 82.553, 83.097, false], ["сука!", 83.097, 83.491, true]]}, {"who": "narr", "start": 84.028, "end": 88.986, "text": "Мораль: не ловите то, что нельзя съесть. Или берите лодку побольше.", "words": [["Мораль:", 84.052, 84.596, false], ["не", 84.596, 84.806, false], ["ловите", 84.806, 85.433, false], ["то,", 85.433, 85.768, false], ["что", 85.768, 85.977, false], ["нельзя", 85.977, 86.395, false], ["съесть.", 86.395, 86.73, false], ["Или", 86.73, 87.149, false], ["берите", 87.149, 87.776, false], ["лодку", 87.776, 88.195, false], ["побольше.", 88.195, 88.948, false]]}], "banner_start": 60.0, "banner_dur": 5.05, "t_d0": 22.72, "t_d1": 57.0, "breach": [[24.92, 26.42], [30.22, 31.72], [35.92, 37.42], [42.02, 43.52], [47.22, 48.72], [52.82, 54.32]], "slots": [[15.0, 16.5], [16.5, 18.0], [18.0, 19.49]], "R": 30}