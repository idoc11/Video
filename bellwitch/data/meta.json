{"duration": 117.51, "lines": [{"who": "narr", "start": 0.8, "end": 5.351, "text": "Теннесси. Тысяча восемьсот семнадцатый год. Ферма Джона Белла.", "words": [["Теннесси.", 0.8, 1.548, false], ["Тысяча", 1.548, 2.171, false], ["восемьсот", 2.171, 2.795, false], ["семнадцатый", 2.795, 3.626, false], ["год.", 3.626, 3.958, false], ["Ферма", 3.958, 4.374, false], ["Джона", 4.374, 4.789, false], ["Белла.", 4.789, 5.33, false]]}, {"who": "narr", "start": 6.051, "end": 12.483, "text": "Однажды вечером Джон увидел на поле странное существо. Собаку с телом кролика. Он выстрелил.", "words": [["Однажды", 6.051, 6.622, false], ["вечером", 6.622, 7.193, false], ["Джон", 7.193, 7.383, false], ["увидел", 7.383, 7.954, false], ["на", 7.954, 8.145, false], ["поле", 8.145, 8.525, false], ["странное", 8.525, 9.096, false], ["существо.", 9.096, 9.781, false], ["Собаку", 9.781, 10.352, false], ["с", 10.352, 10.542, false], ["телом", 10.542, 10.923, false], ["кролика.", 10.923, 11.608, false], ["Он", 11.608, 11.798, false], ["выстрелил.", 11.798, 12.483, false]]}, {"who": "narr", "start": 13.483, "end": 15.364, "text": "С той ночи в доме начались царапины.", "words": [["С", 13.486, 13.614, false], ["той", 13.614, 13.742, false], ["ночи", 13.742, 13.999, false], ["в", 13.999, 14.127, false], ["доме", 14.127, 14.383, false], ["начались", 14.383, 14.768, false], ["царапины.", 14.768, 15.358, false]]}, {"who": "narr", "start": 16.964, "end": 20.029, "text": "Тихие. В стенах. Каждую ночь. Всё громче.", "words": [["Тихие.", 16.967, 17.683, false], ["В", 17.683, 17.882, false], ["стенах.", 17.882, 18.399, false], ["Каждую", 18.399, 18.995, false], ["ночь.", 18.995, 19.313, false], ["Всё", 19.313, 19.512, false], ["громче.", 19.512, 20.029, false]]}, {"who": "bet", "start": 21.029, "end": 22.943, "text": "Мама... Кто-то скребётся в стене.", "words": [["Мама...", 21.056, 21.482, false], ["Кто-то", 21.482, 21.809, false], ["скребётся", 21.809, 22.3, false], ["в", 22.3, 22.464, false], ["стене.", 22.464, 22.889, false]]}, {"who": "narr", "start": 24.143, "end": 27.196, "text": "Потом одеяла начали срываться с кроватей. Сами.", "words": [["Потом", 24.143, 24.46, false], ["одеяла", 24.46, 25.095, false], ["начали", 25.095, 25.571, false], ["срываться", 25.571, 26.047, false], ["с", 26.047, 26.206, false], ["кроватей.", 26.206, 26.777, false], ["Сами.", 26.777, 27.189, false]]}, {"who": "narr", "start": 27.696, "end": 30.738, "text": "Дети слышали шёпот. Он звал их по именам.", "words": [["Дети", 27.697, 28.096, false], ["слышали", 28.096, 28.695, false], ["шёпот.", 28.695, 29.214, false], ["Он", 29.214, 29.414, false], ["звал", 29.414, 29.613, false], ["их", 29.613, 29.813, false], ["по", 29.813, 30.013, false], ["именам.", 30.013, 30.731, false]]}, {"who": "wit", "start": 31.938, "end": 32.978, "text": "Бетси... Бетси...", "words": [["Бетси...", 31.967, 32.444, false], ["Бетси...", 32.444, 32.92, false]]}, {"who": "narr", "start": 39.228, "end": 45.498, "text": "Больше всех страдала двенадцатилетняя Бетси. Невидимая рука била её по лицу. Тянула за волосы.", "words": [["Больше", 39.24, 39.571, false], ["всех", 39.571, 39.737, false], ["страдала", 39.737, 40.233, false], ["двенадцатилетняя", 40.233, 41.392, false], ["Бетси.", 41.392, 41.822, false], ["Невидимая", 41.822, 42.65, false], ["рука", 42.65, 42.981, false], ["била", 42.981, 43.312, false], ["её", 43.312, 43.643, false], ["по", 43.643, 43.809, false], ["лицу.", 43.809, 44.239, false], ["Тянула", 44.239, 44.736, false], ["за", 44.736, 44.902, false], ["волосы.", 44.902, 45.498, false]]}, {"who": "bet", "start": 45.998, "end": 47.971, "text": "Прекратите! Оставьте меня!", "words": [["Прекратите!", 46.023, 46.875, false], ["Оставьте", 46.875, 47.43, false], ["меня!", 47.43, 47.911, false]]}, {"who": "narr", "start": 49.171, "end": 54.221, "text": "Однажды ночью она выбежала в лес. Но тот, кто шёл за ней, был быстрее.", "words": [["Однажды", 49.178, 49.774, false], ["ночью", 49.774, 50.171, false], ["она", 50.171, 50.568, false], ["выбежала", 50.568, 51.362, false], ["в", 51.362, 51.56, false], ["лес.", 51.56, 51.878, false], ["Но", 51.878, 52.076, false], ["тот,", 52.076, 52.394, false], ["кто", 52.394, 52.592, false], ["шёл", 52.592, 52.791, false], ["за", 52.791, 52.989, false], ["ней,", 52.989, 53.307, false], ["был", 53.307, 53.506, false], ["быстрее.", 53.506, 54.22, false]]}, {"who": "narr", "start": 54.821, "end": 59.256, "text": "Следы в листве появлялись прямо за её спиной. Но рядом никого не было.", "words": [["Следы", 54.827, 55.164, false], ["в", 55.164, 55.333, false], ["листве", 55.333, 55.67, false], ["появлялись", 55.67, 56.345, false], ["прямо", 56.345, 56.683, false], ["за", 56.683, 56.852, false], ["её", 56.852, 57.189, false], ["спиной.", 57.189, 57.628, false], ["Но", 57.628, 57.797, false], ["рядом", 57.797, 58.134, false], ["никого", 58.134, 58.641, false], ["не", 58.641, 58.809, false], ["было.", 58.809, 59.248, false]]}, {"who": "wit", "start": 60.056, "end": 62.572, "text": "Я иду за тобой, Бетси.", "words": [["Я", 60.084, 60.349, false], ["иду", 60.349, 60.878, false], ["за", 60.878, 61.143, false], ["тобой,", 61.143, 61.831, false], ["Бетси.", 61.831, 62.52, false]]}, {"who": "narr", "start": 65.372, "end": 70.631, "text": "Декабрь тысяча восемьсот двадцатого. Джон Белл не смог подняться с постели.", "words": [["Декабрь", 65.464, 65.887, false], ["тысяча", 65.887, 66.522, false], ["восемьсот", 66.522, 67.156, false], ["двадцатого.", 67.156, 68.13, false], ["Джон", 68.13, 68.341, false], ["Белл", 68.341, 68.553, false], ["не", 68.553, 68.764, false], ["смог", 68.764, 68.976, false], ["подняться", 68.976, 69.61, false], ["с", 69.61, 69.822, false], ["постели.", 69.822, 70.584, false]]}, {"who": "narr", "start": 77.454, "end": 83.236, "text": "В шкафу нашли тёмный пузырёк. Каплю дали коту. Кот умер сразу. А голос в комнате сказал:", "words": [["В", 77.489, 77.666, false], ["шкафу", 77.666, 78.02, false], ["нашли", 78.02, 78.374, false], ["тёмный", 78.374, 78.729, false], ["пузырёк.", 78.729, 79.366, false], ["Каплю", 79.366, 79.72, false], ["дали", 79.72, 80.075, false], ["коту.", 80.075, 80.535, false], ["Кот", 80.535, 80.712, false], ["умер", 80.712, 81.066, false], ["сразу.", 81.066, 81.527, false], ["А", 81.527, 81.704, false], ["голос", 81.704, 82.058, false], ["в", 82.058, 82.235, false], ["комнате", 82.235, 82.767, false], ["сказал:", 82.767, 83.227, false]]}, {"who": "wit", "start": 84.136, "end": 88.641, "text": "Я дала старику Джеку лишнюю дозу. Этой ночью.", "words": [["Я", 84.162, 84.406, false], ["дала", 84.406, 84.893, false], ["старику", 84.893, 85.624, false], ["Джеку", 85.624, 86.112, false], ["лишнюю", 86.112, 86.843, false], ["дозу.", 86.843, 87.477, false], ["Этой", 87.477, 87.964, false], ["ночью.", 87.964, 88.598, false]]}, {"who": "narr", "start": 94.891, "end": 101.567, "text": "Джон умер на следующий день. На похоронах невидимый голос пел весёлую песню о бренди. А потом смеялся.", "words": [["Джон", 94.963, 95.137, false], ["умер", 95.137, 95.487, false], ["на", 95.487, 95.661, false], ["следующий", 95.661, 96.36, false], ["день.", 96.36, 96.639, false], ["На", 96.639, 96.814, false], ["похоронах", 96.814, 97.512, false], ["невидимый", 97.512, 98.21, false], ["голос", 98.21, 98.56, false], ["пел", 98.56, 98.734, false], ["весёлую", 98.734, 99.433, false], ["песню", 99.433, 99.782, false], ["о", 99.782, 99.957, false], ["бренди.", 99.957, 100.411, false], ["А", 100.411, 100.585, false], ["потом", 100.585, 100.934, false], ["смеялся.", 100.934, 101.563, false]]}, {"who": "narr", "start": 106.551, "end": 112.055, "text": "Ведьма пообещала вернуться через семь лет. И в тысяча восемьсот двадцать восьмом она вернулась.", "words": [["Ведьма", 106.647, 106.982, false], ["пообещала", 106.982, 107.821, false], ["вернуться", 107.821, 108.325, false], ["через", 108.325, 108.66, false], ["семь", 108.66, 108.828, false], ["лет.", 108.828, 109.097, false], ["И", 109.097, 109.264, false], ["в", 109.264, 109.432, false], ["тысяча", 109.432, 109.936, false], ["восемьсот", 109.936, 110.439, false], ["двадцать", 110.439, 110.775, false], ["восьмом", 110.775, 111.11, false], ["она", 111.11, 111.446, false], ["вернулась.", 111.446, 112.05, false]]}, {"who": "wit", "start": 113.455, "end": 114.913, "text": "Я вернулась.", "words": [["Я", 113.482, 113.783, false], ["вернулась.", 113.783, 114.867, false]]}, {"who": "narr", "start": 71.531, "end": 76.454, "text": "Язык распух. Он не мог ни говорить, ни глотать. Врачи только разводили руками.", "words": [["Язык", 71.531, 71.89, false], ["распух.", 71.89, 72.356, false], ["Он", 72.356, 72.535, false], ["не", 72.535, 72.714, false], ["мог", 72.714, 72.893, false], ["ни", 72.893, 73.072, false], ["говорить,", 73.072, 73.717, false], ["ни", 73.717, 73.896, false], ["глотать.", 73.896, 74.362, false], ["Врачи", 74.362, 74.721, false], ["только", 74.721, 75.079, false], ["разводили", 75.079, 75.796, false], ["руками.", 75.796, 76.441, false]]}, {"who": "narr", "start": 102.767, "end": 105.251, "text": "Семья молчала. Даже ветер стих.", "words": [["Семья", 102.77, 103.213, false], ["молчала.", 103.213, 104.011, false], ["Даже", 104.011, 104.454, false], ["ветер", 104.454, 104.897, false], ["стих.", 104.897, 105.251, false]]}], "banners": [33.58, 89.24], "banner_start": 33.58, "banner_dur": 5.05, "cut": 63.97, "part2_start": 64.87}