{"duration": 100.99, "lines": [{"who": "narr", "start": 0.8, "end": 5.698, "text": "Теннесси. Тысяча восемьсот семнадцатый год. Ферма Джона Белла.", "words": [["Теннесси.", 0.803, 1.606, false], ["Тысяча", 1.606, 2.274, false], ["восемьсот", 2.274, 2.943, false], ["семнадцатый", 2.943, 3.835, false], ["год.", 3.835, 4.191, false], ["Ферма", 4.191, 4.637, false], ["Джона", 4.637, 5.083, false], ["Белла.", 5.083, 5.663, false]]}, {"who": "narr", "start": 6.398, "end": 13.045, "text": "Однажды вечером Джон увидел на поле странное существо. Собаку с телом кролика. Он выстрелил.", "words": [["Однажды", 6.398, 6.984, false], ["вечером", 6.984, 7.571, false], ["Джон", 7.571, 7.766, false], ["увидел", 7.766, 8.353, false], ["на", 8.353, 8.548, false], ["поле", 8.548, 8.939, false], ["странное", 8.939, 9.526, false], ["существо.", 9.526, 10.229, false], ["Собаку", 10.229, 10.816, false], ["с", 10.816, 11.011, false], ["телом", 11.011, 11.402, false], ["кролика.", 11.402, 12.106, false], ["Он", 12.106, 12.302, false], ["выстрелил.", 12.302, 13.005, false]]}, {"who": "narr", "start": 14.045, "end": 15.965, "text": "С той ночи в доме начались царапины.", "words": [["С", 14.049, 14.176, false], ["той", 14.176, 14.303, false], ["ночи", 14.303, 14.557, false], ["в", 14.557, 14.684, false], ["доме", 14.684, 14.938, false], ["начались", 14.938, 15.32, false], ["царапины.", 15.32, 15.904, false]]}, {"who": "narr", "start": 17.565, "end": 20.67, "text": "Тихие. В стенах. Каждую ночь. Всё громче.", "words": [["Тихие.", 17.569, 18.283, false], ["В", 18.283, 18.481, false], ["стенах.", 18.481, 18.997, false], ["Каждую", 18.997, 19.592, false], ["ночь.", 19.592, 19.909, false], ["Всё", 19.909, 20.107, false], ["громче.", 20.107, 20.623, false]]}, {"who": "bet", "start": 21.67, "end": 23.71, "text": "Мама... Кто-то скребётся в стене.", "words": [["Мама...", 21.695, 22.154, false], ["Кто-то", 22.154, 22.507, false], ["скребётся", 22.507, 23.037, false], ["в", 23.037, 23.213, false], ["стене.", 23.213, 23.672, false]]}, {"who": "narr", "start": 24.91, "end": 28.238, "text": "Потом одеяла начали срываться с кроватей. Сами.", "words": [["Потом", 24.91, 25.252, false], ["одеяла", 25.252, 25.936, false], ["начали", 25.936, 26.449, false], ["срываться", 26.449, 26.963, false], ["с", 26.963, 27.134, false], ["кроватей.", 27.134, 27.749, false], ["Сами.", 27.749, 28.194, false]]}, {"who": "narr", "start": 28.738, "end": 32.12, "text": "Дети слышали шёпот. Он звал их по именам.", "words": [["Дети", 28.754, 29.188, false], ["слышали", 29.188, 29.84, false], ["шёпот.", 29.84, 30.405, false], ["Он", 30.405, 30.622, false], ["звал", 30.622, 30.839, false], ["их", 30.839, 31.057, false], ["по", 31.057, 31.274, false], ["именам.", 31.274, 32.056, false]]}, {"who": "wit", "start": 33.32, "end": 34.709, "text": "Бетси... Бетси...", "words": [["Бетси...", 33.347, 33.937, false], ["Бетси...", 33.937, 34.526, false]]}, {"who": "narr", "start": 35.709, "end": 41.932, "text": "Больше всех страдала двенадцатилетняя Бетси. Невидимая рука била её по лицу. Тянула за волосы.", "words": [["Больше", 35.713, 36.039, false], ["всех", 36.039, 36.202, false], ["страдала", 36.202, 36.692, false], ["двенадцатилетняя", 36.692, 37.833, false], ["Бетси.", 37.833, 38.257, false], ["Невидимая", 38.257, 39.073, false], ["рука", 39.073, 39.399, false], ["била", 39.399, 39.725, false], ["её", 39.725, 40.052, false], ["по", 40.052, 40.215, false], ["лицу.", 40.215, 40.639, false], ["Тянула", 40.639, 41.128, false], ["за", 41.128, 41.291, false], ["волосы.", 41.291, 41.878, false]]}, {"who": "bet", "start": 42.432, "end": 44.332, "text": "Прекратите! Оставьте меня!", "words": [["Прекратите!", 42.455, 43.285, false], ["Оставьте", 43.285, 43.827, false], ["меня!", 43.827, 44.296, false]]}, {"who": "narr", "start": 45.532, "end": 50.468, "text": "Однажды ночью она выбежала в лес. Но тот, кто шёл за ней, был быстрее.", "words": [["Однажды", 45.538, 46.115, false], ["ночью", 46.115, 46.499, false], ["она", 46.499, 46.883, false], ["выбежала", 46.883, 47.651, false], ["в", 47.651, 47.843, false], ["лес.", 47.843, 48.151, false], ["Но", 48.151, 48.343, false], ["тот,", 48.343, 48.65, false], ["кто", 48.65, 48.842, false], ["шёл", 48.842, 49.034, false], ["за", 49.034, 49.226, false], ["ней,", 49.226, 49.533, false], ["был", 49.533, 49.726, false], ["быстрее.", 49.726, 50.417, false]]}, {"who": "narr", "start": 51.068, "end": 55.424, "text": "Следы в листве появлялись прямо за её спиной. Но рядом никого не было.", "words": [["Следы", 51.077, 51.403, false], ["в", 51.403, 51.566, false], ["листве", 51.566, 51.892, false], ["появлялись", 51.892, 52.543, false], ["прямо", 52.543, 52.869, false], ["за", 52.869, 53.032, false], ["её", 53.032, 53.358, false], ["спиной.", 53.358, 53.782, false], ["Но", 53.782, 53.945, false], ["рядом", 53.945, 54.27, false], ["никого", 54.27, 54.759, false], ["не", 54.759, 54.922, false], ["было.", 54.922, 55.346, false]]}, {"who": "wit", "start": 56.224, "end": 59.264, "text": "Я иду за тобой, Бетси.", "words": [["Я", 56.249, 56.55, false], ["иду", 56.55, 57.151, false], ["за", 57.151, 57.451, false], ["тобой,", 57.451, 58.233, false], ["Бетси.", 58.233, 59.014, false]]}, {"who": "narr", "start": 65.65, "end": 70.828, "text": "Декабрь тысяча восемьсот двадцатого. Джон Белл не смог подняться с постели.", "words": [["Декабрь", 65.655, 66.079, false], ["тысяча", 66.079, 66.714, false], ["восемьсот", 66.714, 67.349, false], ["двадцатого.", 67.349, 68.323, false], ["Джон", 68.323, 68.534, false], ["Белл", 68.534, 68.746, false], ["не", 68.746, 68.958, false], ["смог", 68.958, 69.169, false], ["подняться", 69.169, 69.804, false], ["с", 69.804, 70.016, false], ["постели.", 70.016, 70.778, false]]}, {"who": "narr", "start": 71.528, "end": 75.144, "text": "В шкафу нашли тёмный пузырёк. А голос в комнате сказал:", "words": [["В", 71.528, 71.704, false], ["шкафу", 71.704, 72.057, false], ["нашли", 72.057, 72.41, false], ["тёмный", 72.41, 72.763, false], ["пузырёк.", 72.763, 73.398, false], ["А", 73.398, 73.574, false], ["голос", 73.574, 73.927, false], ["в", 73.927, 74.103, false], ["комнате", 74.103, 74.633, false], ["сказал:", 74.633, 75.091, false]]}, {"who": "wit", "start": 76.044, "end": 81.249, "text": "Я дала старику Джеку лишнюю дозу. Этой ночью.", "words": [["Я", 76.069, 76.34, false], ["дала", 76.34, 76.883, false], ["старику", 76.883, 77.696, false], ["Джеку", 77.696, 78.238, false], ["лишнюю", 78.238, 79.051, false], ["дозу.", 79.051, 79.756, false], ["Этой", 79.756, 80.298, false], ["ночью.", 80.298, 81.003, false]]}, {"who": "narr", "start": 82.549, "end": 88.098, "text": "Джон умер на следующий день. На похоронах невидимый голос пел весёлую песню о бренди.", "words": [["Джон", 82.55, 82.725, false], ["умер", 82.725, 83.076, false], ["на", 83.076, 83.251, false], ["следующий", 83.251, 83.952, false], ["день.", 83.952, 84.232, false], ["На", 84.232, 84.408, false], ["похоронах", 84.408, 85.109, false], ["невидимый", 85.109, 85.81, false], ["голос", 85.81, 86.16, false], ["пел", 86.16, 86.335, false], ["весёлую", 86.335, 87.036, false], ["песню", 87.036, 87.387, false], ["о", 87.387, 87.562, false], ["бренди.", 87.562, 88.018, false]]}, {"who": "narr", "start": 89.398, "end": 95.017, "text": "Ведьма пообещала вернуться через семь лет. И в тысяча восемьсот двадцать восьмом она вернулась.", "words": [["Ведьма", 89.404, 89.748, false], ["пообещала", 89.748, 90.607, false], ["вернуться", 90.607, 91.123, false], ["через", 91.123, 91.467, false], ["семь", 91.467, 91.639, false], ["лет.", 91.639, 91.914, false], ["И", 91.914, 92.086, false], ["в", 92.086, 92.258, false], ["тысяча", 92.258, 92.774, false], ["восемьсот", 92.774, 93.29, false], ["двадцать", 93.29, 93.633, false], ["восьмом", 93.633, 93.977, false], ["она", 93.977, 94.321, false], ["вернулась.", 94.321, 94.94, false]]}, {"who": "wit", "start": 96.417, "end": 98.387, "text": "Я вернулась.", "words": [["Я", 96.442, 96.825, false], ["вернулась.", 96.825, 98.203, false]]}], "banner_start": 60.0, "banner_dur": 5.05}