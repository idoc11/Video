{"duration": 99.35, "lines": [{"who": "narr", "start": 0.8, "end": 5.351, "text": "Теннесси. Тысяча восемьсот семнадцатый год. Ферма Джона Белла.", "words": [["Теннесси.", 0.8, 1.548, false], ["Тысяча", 1.548, 2.171, false], ["восемьсот", 2.171, 2.795, false], ["семнадцатый", 2.795, 3.626, false], ["год.", 3.626, 3.958, false], ["Ферма", 3.958, 4.374, false], ["Джона", 4.374, 4.789, false], ["Белла.", 4.789, 5.33, false]]}, {"who": "narr", "start": 6.051, "end": 12.483, "text": "Однажды вечером Джон увидел на поле странное существо. Собаку с телом кролика. Он выстрелил.", "words": [["Однажды", 6.051, 6.622, false], ["вечером", 6.622, 7.193, false], ["Джон", 7.193, 7.383, false], ["увидел", 7.383, 7.954, false], ["на", 7.954, 8.145, false], ["поле", 8.145, 8.525, false], ["странное", 8.525, 9.096, false], ["существо.", 9.096, 9.781, false], ["Собаку", 9.781, 10.352, false], ["с", 10.352, 10.542, false], ["телом", 10.542, 10.923, false], ["кролика.", 10.923, 11.608, false], ["Он", 11.608, 11.798, false], ["выстрелил.", 11.798, 12.483, false]]}, {"who": "narr", "start": 13.483, "end": 15.364, "text": "С той ночи в доме начались царапины.", "words": [["С", 13.486, 13.614, false], ["той", 13.614, 13.742, false], ["ночи", 13.742, 13.999, false], ["в", 13.999, 14.127, false], ["доме", 14.127, 14.383, false], ["начались", 14.383, 14.768, false], ["царапины.", 14.768, 15.358, false]]}, {"who": "narr", "start": 16.964, "end": 20.029, "text": "Тихие. В стенах. Каждую ночь. Всё громче.", "words": [["Тихие.", 16.967, 17.683, false], ["В", 17.683, 17.882, false], ["стенах.", 17.882, 18.399, false], ["Каждую", 18.399, 18.995, false], ["ночь.", 18.995, 19.313, false], ["Всё", 19.313, 19.512, false], ["громче.", 19.512, 20.029, false]]}, {"who": "bet", "start": 21.029, "end": 22.943, "text": "Мама... Кто-то скребётся в стене.", "words": [["Мама...", 21.056, 21.482, false], ["Кто-то", 21.482, 21.809, false], ["скребётся", 21.809, 22.3, false], ["в", 22.3, 22.464, false], ["стене.", 22.464, 22.889, false]]}, {"who": "narr", "start": 24.143, "end": 27.196, "text": "Потом одеяла начали срываться с кроватей. Сами.", "words": [["Потом", 24.143, 24.46, false], ["одеяла", 24.46, 25.095, false], ["начали", 25.095, 25.571, false], ["срываться", 25.571, 26.047, false], ["с", 26.047, 26.206, false], ["кроватей.", 26.206, 26.777, false], ["Сами.", 26.777, 27.189, false]]}, {"who": "narr", "start": 27.696, "end": 30.738, "text": "Дети слышали шёпот. Он звал их по именам.", "words": [["Дети", 27.697, 28.096, false], ["слышали", 28.096, 28.695, false], ["шёпот.", 28.695, 29.214, false], ["Он", 29.214, 29.414, false], ["звал", 29.414, 29.613, false], ["их", 29.613, 29.813, false], ["по", 29.813, 30.013, false], ["именам.", 30.013, 30.731, false]]}, {"who": "wit", "start": 31.938, "end": 32.978, "text": "Бетси... Бетси...", "words": [["Бетси...", 31.967, 32.444, false], ["Бетси...", 32.444, 32.92, false]]}, {"who": "narr", "start": 33.978, "end": 40.248, "text": "Больше всех страдала двенадцатилетняя Бетси. Невидимая рука била её по лицу. Тянула за волосы.", "words": [["Больше", 33.99, 34.321, false], ["всех", 34.321, 34.487, false], ["страдала", 34.487, 34.983, false], ["двенадцатилетняя", 34.983, 36.142, false], ["Бетси.", 36.142, 36.572, false], ["Невидимая", 36.572, 37.4, false], ["рука", 37.4, 37.731, false], ["била", 37.731, 38.062, false], ["её", 38.062, 38.393, false], ["по", 38.393, 38.559, false], ["лицу.", 38.559, 38.989, false], ["Тянула", 38.989, 39.486, false], ["за", 39.486, 39.652, false], ["волосы.", 39.652, 40.248, false]]}, {"who": "bet", "start": 40.748, "end": 42.721, "text": "Прекратите! Оставьте меня!", "words": [["Прекратите!", 40.773, 41.625, false], ["Оставьте", 41.625, 42.18, false], ["меня!", 42.18, 42.661, false]]}, {"who": "narr", "start": 43.921, "end": 48.971, "text": "Однажды ночью она выбежала в лес. Но тот, кто шёл за ней, был быстрее.", "words": [["Однажды", 43.928, 44.524, false], ["ночью", 44.524, 44.921, false], ["она", 44.921, 45.318, false], ["выбежала", 45.318, 46.112, false], ["в", 46.112, 46.31, false], ["лес.", 46.31, 46.628, false], ["Но", 46.628, 46.826, false], ["тот,", 46.826, 47.144, false], ["кто", 47.144, 47.342, false], ["шёл", 47.342, 47.541, false], ["за", 47.541, 47.739, false], ["ней,", 47.739, 48.057, false], ["был", 48.057, 48.256, false], ["быстрее.", 48.256, 48.97, false]]}, {"who": "narr", "start": 49.571, "end": 54.006, "text": "Следы в листве появлялись прямо за её спиной. Но рядом никого не было.", "words": [["Следы", 49.577, 49.914, false], ["в", 49.914, 50.083, false], ["листве", 50.083, 50.42, false], ["появлялись", 50.42, 51.095, false], ["прямо", 51.095, 51.433, false], ["за", 51.433, 51.602, false], ["её", 51.602, 51.939, false], ["спиной.", 51.939, 52.378, false], ["Но", 52.378, 52.547, false], ["рядом", 52.547, 52.884, false], ["никого", 52.884, 53.391, false], ["не", 53.391, 53.559, false], ["было.", 53.559, 53.998, false]]}, {"who": "wit", "start": 54.806, "end": 57.322, "text": "Я иду за тобой, Бетси.", "words": [["Я", 54.834, 55.099, false], ["иду", 55.099, 55.628, false], ["за", 55.628, 55.893, false], ["тобой,", 55.893, 56.581, false], ["Бетси.", 56.581, 57.27, false]]}, {"who": "narr", "start": 65.65, "end": 70.909, "text": "Декабрь тысяча восемьсот двадцатого. Джон Белл не смог подняться с постели.", "words": [["Декабрь", 65.742, 66.165, false], ["тысяча", 66.165, 66.8, false], ["восемьсот", 66.8, 67.434, false], ["двадцатого.", 67.434, 68.408, false], ["Джон", 68.408, 68.619, false], ["Белл", 68.619, 68.831, false], ["не", 68.831, 69.042, false], ["смог", 69.042, 69.254, false], ["подняться", 69.254, 69.888, false], ["с", 69.888, 70.1, false], ["постели.", 70.1, 70.862, false]]}, {"who": "narr", "start": 71.609, "end": 75.139, "text": "В шкафу нашли тёмный пузырёк. А голос в комнате сказал:", "words": [["В", 71.62, 71.793, false], ["шкафу", 71.793, 72.14, false], ["нашли", 72.14, 72.487, false], ["тёмный", 72.487, 72.833, false], ["пузырёк.", 72.833, 73.457, false], ["А", 73.457, 73.631, false], ["голос", 73.631, 73.977, false], ["в", 73.977, 74.151, false], ["комнате", 74.151, 74.671, false], ["сказал:", 74.671, 75.122, false]]}, {"who": "wit", "start": 76.039, "end": 80.544, "text": "Я дала старику Джеку лишнюю дозу. Этой ночью.", "words": [["Я", 76.065, 76.309, false], ["дала", 76.309, 76.796, false], ["старику", 76.796, 77.527, false], ["Джеку", 77.527, 78.015, false], ["лишнюю", 78.015, 78.746, false], ["дозу.", 78.746, 79.38, false], ["Этой", 79.38, 79.867, false], ["ночью.", 79.867, 80.501, false]]}, {"who": "narr", "start": 81.844, "end": 87.092, "text": "Джон умер на следующий день. На похоронах невидимый голос пел весёлую песню о бренди.", "words": [["Джон", 81.873, 82.04, false], ["умер", 82.04, 82.374, false], ["на", 82.374, 82.541, false], ["следующий", 82.541, 83.209, false], ["день.", 83.209, 83.476, false], ["На", 83.476, 83.643, false], ["похоронах", 83.643, 84.312, false], ["невидимый", 84.312, 84.98, false], ["голос", 84.98, 85.314, false], ["пел", 85.314, 85.481, false], ["весёлую", 85.481, 86.149, false], ["песню", 86.149, 86.483, false], ["о", 86.483, 86.65, false], ["бренди.", 86.65, 87.085, false]]}, {"who": "narr", "start": 88.392, "end": 93.895, "text": "Ведьма пообещала вернуться через семь лет. И в тысяча восемьсот двадцать восьмом она вернулась.", "words": [["Ведьма", 88.487, 88.823, false], ["пообещала", 88.823, 89.662, false], ["вернуться", 89.662, 90.165, false], ["через", 90.165, 90.501, false], ["семь", 90.501, 90.669, false], ["лет.", 90.669, 90.937, false], ["И", 90.937, 91.105, false], ["в", 91.105, 91.273, false], ["тысяча", 91.273, 91.776, false], ["восемьсот", 91.776, 92.279, false], ["двадцать", 92.279, 92.615, false], ["восьмом", 92.615, 92.951, false], ["она", 92.951, 93.286, false], ["вернулась.", 93.286, 93.89, false]]}, {"who": "wit", "start": 95.295, "end": 96.754, "text": "Я вернулась.", "words": [["Я", 95.322, 95.623, false], ["вернулась.", 95.623, 96.707, false]]}], "banner_start": 60.0, "banner_dur": 5.05}