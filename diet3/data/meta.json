{"duration": 76.43, "lines": [{"who": "narr", "start": 0.5, "end": 4.961, "text": "День третий. Макс решил покончить с холодильником раз и навсегда.", "words": [["День", 0.525, 0.732, false], ["третий.", 0.732, 1.271, false], ["Макс", 1.271, 1.478, false], ["решил", 1.478, 1.892, false], ["покончить", 1.892, 2.514, false], ["с", 2.514, 2.721, false], ["холодильником", 2.721, 3.757, false], ["раз", 3.757, 3.964, false], ["и", 3.964, 4.171, false], ["навсегда.", 4.171, 4.917, false]]}, {"who": "max", "start": 5.211, "end": 6.658, "text": "Сегодня ты проиграешь, сука!", "words": [["Сегодня", 5.236, 5.61, false], ["ты", 5.61, 5.734, false], ["проиграешь,", 5.734, 6.308, false], ["сука!", 6.308, 6.632, true]]}, {"who": "fri", "start": 6.958, "end": 10.286, "text": "Макс. Ты же знаешь, что у меня внутри. Сыр. Колбаса. Борщ.", "words": [["Макс.", 6.973, 7.23, false], ["Ты", 7.23, 7.39, false], ["же", 7.39, 7.551, false], ["знаешь,", 7.551, 7.968, false], ["что", 7.968, 8.128, false], ["у", 8.128, 8.289, false], ["меня", 8.289, 8.61, false], ["внутри.", 8.61, 9.027, false], ["Сыр.", 9.027, 9.283, false], ["Колбаса.", 9.283, 9.861, false], ["Борщ.", 9.861, 10.118, false]]}, {"who": "narr", "start": 10.586, "end": 16.114, "text": "Макс закрыл глаза и пошёл в атаку. Без оружия. Только со скалкой.", "words": [["Макс", 10.612, 10.842, false], ["закрыл", 10.842, 11.301, false], ["глаза", 11.301, 11.761, false], ["и", 11.761, 11.991, false], ["пошёл", 11.991, 12.451, false], ["в", 12.451, 12.68, false], ["атаку.", 12.68, 13.508, false], ["Без", 13.508, 13.738, false], ["оружия.", 13.738, 14.795, false], ["Только", 14.795, 15.255, false], ["со", 15.255, 15.485, false], ["скалкой.", 15.485, 16.082, false]]}, {"who": "max", "start": 16.264, "end": 17.374, "text": "Получай, железяка!", "words": [["Получай,", 16.29, 16.754, false], ["железяка!", 16.754, 17.347, false]]}, {"who": "narr", "start": 17.724, "end": 23.119, "text": "Холодильник даже не покачнулся. Он просто открыл дверцу. И запахло борщом.", "words": [["Холодильник", 17.732, 18.563, false], ["даже", 18.563, 18.979, false], ["не", 18.979, 19.187, false], ["покачнулся.", 19.187, 20.142, false], ["Он", 20.142, 20.35, false], ["просто", 20.35, 20.766, false], ["открыл", 20.766, 21.181, false], ["дверцу.", 21.181, 21.721, false], ["И", 21.721, 21.929, false], ["запахло", 21.929, 22.552, false], ["борщом.", 22.552, 23.093, false]]}, {"who": "max", "start": 23.419, "end": 24.774, "text": "Блядь. Это нечестно.", "words": [["Блядь.", 23.444, 23.73, true], ["Это", 23.73, 24.086, false], ["нечестно.", 24.086, 24.728, false]]}, {"who": "narr", "start": 25.074, "end": 29.945, "text": "Макс упал на колени. Вытер слёзы скалкой. И плюнул на диету.", "words": [["Макс", 25.099, 25.32, false], ["упал", 25.32, 25.761, false], ["на", 25.761, 25.982, false], ["колени.", 25.982, 26.777, false], ["Вытер", 26.777, 27.218, false], ["слёзы", 27.218, 27.66, false], ["скалкой.", 27.66, 28.234, false], ["И", 28.234, 28.454, false], ["плюнул", 28.454, 28.896, false], ["на", 28.896, 29.116, false], ["диету.", 29.116, 29.911, false]]}, {"who": "fri", "start": 30.245, "end": 33.617, "text": "Давай, Макс. Всего одну ложечку. Никто не узнает.", "words": [["Давай,", 30.277, 30.721, false], ["Макс.", 30.721, 30.995, false], ["Всего", 30.995, 31.337, false], ["одну", 31.337, 31.679, false], ["ложечку.", 31.679, 32.295, false], ["Никто", 32.295, 32.637, false], ["не", 32.637, 32.809, false], ["узнает.", 32.809, 33.424, false]]}, {"who": "max", "start": 33.867, "end": 35.347, "text": "Одну ложечку... Только одну...", "words": [["Одну", 33.892, 34.16, false], ["ложечку...", 34.16, 34.642, false], ["Только", 34.642, 34.91, false], ["одну...", 34.91, 35.258, false]]}, {"who": "narr", "start": 35.647, "end": 42.048, "text": "Через минуту Макс сидел в холодильнике, как в бассейне из борща. Ел руками. Плакал от счастья.", "words": [["Через", 35.653, 36.033, false], ["минуту", 36.033, 36.604, false], ["Макс", 36.604, 36.794, false], ["сидел", 36.794, 37.175, false], ["в", 37.175, 37.365, false], ["холодильнике,", 37.365, 38.43, false], ["как", 38.43, 38.62, false], ["в", 38.62, 38.81, false], ["бассейне", 38.81, 39.381, false], ["из", 39.381, 39.571, false], ["борща.", 39.571, 40.066, false], ["Ел", 40.066, 40.256, false], ["руками.", 40.256, 40.941, false], ["Плакал", 40.941, 41.321, false], ["от", 41.321, 41.511, false], ["счастья.", 41.511, 42.006, false]]}, {"who": "max", "start": 42.298, "end": 44.614, "text": "Нахуй диету! Борщ — это здоровье!", "words": [["Нахуй", 42.326, 42.695, true], ["диету!", 42.695, 43.36, false], ["Борщ", 43.36, 43.544, false], ["это", 43.544, 43.914, false], ["здоровье!", 43.914, 44.578, false]]}, {"who": "narr", "start": 44.914, "end": 46.468, "text": "И тут вошла мама.", "words": [["И", 44.939, 45.167, false], ["тут", 45.167, 45.394, false], ["вошла", 45.394, 45.849, false], ["мама.", 45.849, 46.44, false]]}, {"who": "mam", "start": 46.668, "end": 49.089, "text": "Максим! Ты почему сидишь в холодильнике?!", "words": [["Максим!", 46.694, 47.098, false], ["Ты", 47.098, 47.253, false], ["почему", 47.253, 47.719, false], ["сидишь", 47.719, 48.03, false], ["в", 48.03, 48.186, false], ["холодильнике?!", 48.186, 49.056, false]]}, {"who": "max", "start": 49.339, "end": 51.184, "text": "Мам, я... проверяю температуру.", "words": [["Мам,", 49.364, 49.589, false], ["я...", 49.589, 49.813, false], ["проверяю", 49.813, 50.374, false], ["температуру.", 50.374, 51.16, false]]}, {"who": "narr", "start": 51.484, "end": 55.593, "text": "Мама посмотрела на холодильник. Холодильник посмотрел на неё.", "words": [["Мама", 51.509, 51.874, false], ["посмотрела", 51.874, 52.604, false], ["на", 52.604, 52.786, false], ["холодильник.", 52.786, 53.626, false], ["Холодильник", 53.626, 54.356, false], ["посмотрел", 54.356, 54.903, false], ["на", 54.903, 55.086, false], ["неё.", 55.086, 55.56, false]]}, {"who": "fri", "start": 65.4, "end": 68.643, "text": "Мария Ивановна. Мы с Максом дружим. Присоединяйтесь.", "words": [["Мария", 65.426, 65.868, false], ["Ивановна.", 65.868, 66.547, false], ["Мы", 66.547, 66.694, false], ["с", 66.694, 66.841, false], ["Максом", 66.841, 67.136, false], ["дружим.", 67.136, 67.52, false], ["Присоединяйтесь.", 67.52, 68.493, false]]}, {"who": "narr", "start": 68.943, "end": 74.826, "text": "Мама достала ложки. Втроём они доели борщ. Диета закончилась. Дружба осталась.", "words": [["Мама", 68.969, 69.365, false], ["достала", 69.365, 69.96, false], ["ложки.", 69.96, 70.475, false], ["Втроём", 70.475, 70.872, false], ["они", 70.872, 71.268, false], ["доели", 71.268, 71.863, false], ["борщ.", 71.863, 72.18, false], ["Диета", 72.18, 72.774, false], ["закончилась.", 72.774, 73.686, false], ["Дружба", 73.686, 74.083, false], ["осталась.", 74.083, 74.796, false]]}], "banner_start": 60.0, "banner_dur": 5.05}